<manifest xmlns:android="http://schemas.android.com/apk/res/android">
<uses-permission android:name="android.permission.RECORD_AUDIO"/>
<uses-permission android:name="android.permission.INTERNET"/>
<queries><intent><action android:name="android.speech.RecognitionService"/></intent><intent><action android:name="android.intent.action.TTS_SERVICE"/></intent></queries>
<application android:label="World Voice Translator" android:allowBackup="false" android:theme="@style/WorldVoiceTheme" android:icon="@drawable/ic_worldvoice" android:roundIcon="@drawable/ic_worldvoice" android:usesCleartextTraffic="false">
